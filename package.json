{
  "name": "@engine9/pii-classifier",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "Source-agnostic PII classifier for fields (classify) and free text (scanText, redactText). Classification only; sampling stays with the caller.",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node scripts/build.mjs --check && node --test \"tests/**/*.test.js\""
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "esbuild": "^0.25.12"
  }
}
